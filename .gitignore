# Data + artifacts (kept by DVC/MLflow)
data/**/*
!data/**/*.dvc
!data/**/.gitkeep

artifacts/**/*
# The generality-study result JSONs are part of the paper's evidence (Sec 4.5)
# and small; they travel with the code.
!artifacts/generality/
!artifacts/generality/*.json
# Every JSON the ICPM paper cites is versioned with the code so the git
# history shows thresholds and results frozen together (docs/paper/MAPPING.md).
!artifacts/ope/
!artifacts/ope/**/
!artifacts/ope/**/ope_dr_boa.json
!artifacts/ope/**/ope_dr_encoder.json
!artifacts/ope/ope_dr_boa.json
!artifacts/ope/ope_dr_encoder.json
!artifacts/fidelity/
!artifacts/fidelity/**/
!artifacts/fidelity/**/*.json
!artifacts/reports/
!artifacts/reports/order_sensitivity/
!artifacts/reports/order_sensitivity/*.json
!artifacts/reports/selection_effect_bpi2012.json
!artifacts/reports/ranking_separation.json
!artifacts/reports/paper_stats.json
!artifacts/reports/ope_sensitivity.json
!artifacts/reports/simbank_diagnosis.json
!artifacts/reports/t_sensitivity/
!artifacts/reports/t_sensitivity/*.json
!artifacts/reports/wait_margin.json
!artifacts/reports/alt_deletion_check.json
!artifacts/reports/threshold_sensitivity.json
!artifacts/reports/seed_stability/
!artifacts/reports/seed_stability/*.json
!artifacts/reports/fase6_chain_summary.json
!artifacts/reports/fase7_chain_summary.json
